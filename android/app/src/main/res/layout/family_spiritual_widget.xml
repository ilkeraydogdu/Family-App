<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_badge_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GÜNÜN HADİS-İ ŞERİFİ &amp; DUASI • CANLI"
        android:textColor="#34D399"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_main_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Rabbimiz! Bize eşlerimizden ve çocuklarımızdan gözümüzün aydınlığı olacak insanlar ihsan et."
        android:textColor="#F8FAFC"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_sub_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Furkan Suresi, 74. Ayet • Sahîh-i Buhârî"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_next_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Sabah 06:00 • Öğle 12:53 • Akşam 18:09"
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
